@startuml
title 架构一：Redisson 分布式可过期信号量（强一致）

node "业务服务实例" {
    component "TtsSemaphore\n(DefaultTtsSemaphoreImpl)"
    component "RedissonClient"
}

node "Redis" {
    component "Lua Script\n(信号量引擎)"
    database "Semaphore State\n(permit + TTL)"
}

"TtsSemaphore\n(DefaultTtsSemaphoreImpl)" --> "RedissonClient"
"RedissonClient" --> "Lua Script\n(信号量引擎)" : tryAcquire / release
"Lua Script\n(信号量引擎)" --> "Semaphore State\n(permit + TTL)"

note right of "Lua Script\n(信号量引擎)"
- 原子清理过期
- 原子校验 permits
- 原子分配 permitId
- WatchDog 自动续期
end note
@enduml
